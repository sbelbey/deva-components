{
  "name": "deva-components",
  "version": "1.0.2",
  "description": "Hooks de búsqueda sin estilo de la familia DEVA (estudio, médico, diagnóstico, obra social, paciente, bioquímico, planilla)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.mjs"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:react19": "npm i --prefix .react19 --no-package-lock --silent react@^19 react-dom@^19 @testing-library/react@^16 @testing-library/dom@^10 && vitest run -c vitest.react19.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "date-fns": "^4.4.0",
    "deva-design": "github:sbelbey/deva-design#v1.1.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "typesVersions": {
    "*": {
      "ui": [
        "./dist/ui.d.ts"
      ]
    }
  }
}
